{
  "name": "multiplayer-game-studio",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25", "npm": ">=11 <12" },
  "scripts": {
    "setup": "node tools/setup.mjs",
    "preview": "npm run dev --prefix games/sample -- --port 5174 --strictPort",
    "astraeum:dev": "node games/sample/node_modules/vite/bin/vite.js --config games/astraeum-tower/vite.config.js",
    "astraeum:smoke": "node games/astraeum-tower/scripts/browser-smoke.mjs",
    "studio:dev": "node studio/start.mjs",
    "studio:smoke": "node studio/scripts/browser-smoke.mjs",
    "studio:persistence:test": "node studio/scripts/persistence-test.mjs",
    "studio:assets:test": "node studio/scripts/assets-test.mjs",
    "verify": "npm run verify --prefix games/sample",
    "build": "npm run build --prefix games/sample",
    "browser:smoke": "npm run browser:smoke --prefix games/sample"
  }
}
